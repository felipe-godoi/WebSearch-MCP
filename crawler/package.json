{
  "name": "websearch-api-crawler",
  "version": "1.0.0",
  "description": "Crawler service for WebSearch API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "generate-docs": "typedoc",
    "generate-api-docs": "ts-node src/scripts/generate-api-docs.ts",
    "docs": "npm run generate-docs && npm run generate-api-docs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "got": "^11.8.6",
    "https-proxy-agent": "^7.0.2",
    "jsdom": "^22.1.0",
    "lodash": "^4.17.21",
    "redis": "^3.1.2",
    "socks-proxy-agent": "^8.0.2",
    "swagger-jsdoc": "^6.2.8",
    "typedoc": "^0.28.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/got": "^9.6.12",
    "@types/jsdom": "^21.1.6",
    "@types/lodash": "^4.14.202",
    "@types/redis": "^2.8.32",
    "@types/swagger-jsdoc": "^6.0.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
